# ==============================================================================
# DocuMind AI — Local Development Environment Configuration
# Ports are aligned to coexist with active FlintFlow containers on the host.
# ==============================================================================

# Application Ports
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
FRONTEND_PORT=3002

# PostgreSQL 16 + pgvector (1024-dim HNSW)
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_secret

# Redis 7 (Cache & Bucket4j Rate Limiting — host 6380 avoids flintflow-redis-1 on 6379)
REDIS_PORT=6380

# MinIO S3-Compatible Object Storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Optional browser-facing origin for SigV4 presigned preview URLs when backend calls internal Docker hostname (e.g. http://minio:9000)
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=documind_minio
MINIO_ROOT_PASSWORD=documind_minio_secret
MINIO_BUCKET=documind-documents

# Embedding Provider — Windows Native Ollama (bge-m3, 1024 dimensions)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# RAG Ingestion & Retrieval Parameters (Calibrated on live bge-m3 in DA-11 Milestone 1)
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.58
RAG_SSE_TIMEOUT=120s
RAG_CACHE_ENABLED=true
RAG_CACHE_L1_TTL=30m
RAG_CACHE_L2_TTL=24h
RAG_CACHE_SEMANTIC_THRESHOLD=0.94
RAG_CACHE_VERSION_TTL=24h

# Primary Chat LLM — Groq Cloud ($0 Free Tier, OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Secondary / Fallback Chat LLM — Google AI Studio Gemini ($0 Free Tier, OpenAI-compatible)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_COMPLETIONS_PATH=/chat/completions
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Stateless JWT Security (DA-12 — Generate a unique >=32-byte random key; required outside dev/local/test profiles)
# JWT_SECRET=
JWT_ISSUER=documind-ai
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ------------------------------------------------------------------------------
# Dev Seed Accounts (Flyway classpath:db/seed/V3__seed_dev_data.sql)
# Opt-in ONLY via SPRING_PROFILES_ACTIVE=dev (application.yml is fail-closed by default)
# Password for all 3 sample accounts: DocuMind@2026!
#   - SYSTEM_ADMIN       (IT):    admin@documind.ai
#   - DEPARTMENT_MANAGER (HR):    manager.hr@documind.ai
#   - STANDARD_EMPLOYEE  (SALES): employee.sales@documind.ai
# ------------------------------------------------------------------------------
